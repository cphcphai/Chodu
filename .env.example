# Telegram File Receiver Bot Configuration

# Your Telegram bot token (get from @BotFather)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Your Telegram user ID (find with @userinfobot or /start in bot)
OWNER_ID=123456789

# Path to SQLite database (default: bot.db, use /var/data/bot.db on Render)
DB_PATH=bot.db

# HTTP health server port (Render sets automatically, default 8080)
PORT=8080
